name: M3 CodeQL evidence

on:
  pull_request:
    paths:
      - "m3/**"
      - ".github/workflows/m3-codeql.yml"
      - "java/ql/lib/**"
      - "shared/**"
  push:
    branches: [main]
    paths:
      - "m3/**"
      - ".github/workflows/m3-codeql.yml"
      - "java/ql/lib/**"
      - "shared/**"
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: m3-codeql-${{ github.ref }}
  cancel-in-progress: true

jobs:
  verify:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: actions/setup-java@cf277c60eb25467037889841efdb72551f06f6c3 # v4
        with:
          distribution: temurin
          java-version: "21"
          cache: maven
          cache-dependency-path: "m3/**/pom.xml"
      - name: Build and test Java modules
        run: mvn -B -ntp -f m3/pom.xml verify
      - name: Verify recipe snapshot
        run: mvn -B -ntp -f m3/recipes/pom.xml exec:java -Dexec.args="verify $GITHUB_WORKSPACE"
      - name: Install the qualified CodeQL CLI
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p "$RUNNER_TEMP/m3-codeql-cli"
          cd "$RUNNER_TEMP/m3-codeql-cli"
          curl --fail --location --retry 3 --output codeql-linux64.zip \
            https://github.com/github/codeql-cli-binaries/releases/download/v2.27.4/codeql-linux64.zip
          echo '393bf92b66596141ec93baf9b483f4a350f3749916c922fed0dd63c67706047d  codeql-linux64.zip' | sha256sum --check
          unzip -q codeql-linux64.zip
          echo "M3_CODEQL=$RUNNER_TEMP/m3-codeql-cli/codeql/codeql" >> "$GITHUB_ENV"
      - name: Check QL formatting
        run: '"$M3_CODEQL" query format --check-only m3/ql/java/*.ql m3/ql/java/*.qll m3/ql/java-tests/evidence/*.ql'
      - name: Run real QL fixture tests
        run: '"$M3_CODEQL" test run --search-path=. --threads=1 --ram=2048 -J-Xmx1400m --fast-compilation --check-databases m3/ql/java-tests'
      - name: Verify fresh extraction and evidence reports
        run: python3 m3/scripts/verify_integration.py --codeql "$M3_CODEQL" --work "$RUNNER_TEMP/m3-codeql-proof"
      - name: Save test evidence
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: m3-codeql-verification
          if-no-files-found: ignore
          path: |
            m3/runtime/target/surefire-reports/
            m3/recipes/target/surefire-reports/
            ${{ runner.temp }}/m3-codeql-proof/*.json
            ${{ runner.temp }}/m3-codeql-proof/*.log
            ${{ runner.temp }}/m3-codeql-proof/analysis/*.tsv
            ${{ runner.temp }}/m3-codeql-proof/analysis/*.md
            ${{ runner.temp }}/m3-codeql-proof/analysis/logs/
